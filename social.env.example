# 네 채널 모두 계정 없는 공개 수집이 기본입니다. 공식 연결을 추가할 때만 필요한 값을 프로젝트 .env에 추가. 실제 토큰을 저장소에 커밋하지 마세요.
# YouTube 공개 검색은 설정 없이 동작합니다.
YOUTUBE_API_KEY=
# Instagram: 프로페셔널 계정과 공개 콘텐츠 접근 승인 필요
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Threads: threads_basic + 승인된 threads_keyword_search
THREADS_ACCESS_TOKEN=
# TikTok: 연결 계정 영상 전용, 전역 검색 API 아님
TIKTOK_ACCESS_TOKEN=
